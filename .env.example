# ==========================================================================
# VersoCafé — variáveis de ambiente. Copie para .env e ajuste os valores.
# ==========================================================================

# Domínio público do app (usado pelo Caddy para roteamento + HTTPS).
# Em produção use seu domínio real (ex.: cafe.suaempresa.com.br).
# Em local, "localhost" usa TLS interno do Caddy.
APP_DOMAIN=localhost

# --- Banco de dados (Postgres) ---
POSTGRES_USER=versocafe
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=versocafe
# URL usada pela API (host "db" = nome do serviço no docker-compose)
DATABASE_URL=postgresql://versocafe:troque-esta-senha@db:5432/versocafe?schema=public

# --- Autenticação ---
# Segredo para assinar os JWT. Gere um valor forte: openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-bem-grande-e-aleatorio
# Validade do token (ex.: 7d, 12h)
JWT_EXPIRES_IN=7d

# --- Admin inicial (criado no seed) ---
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@versocafe.local
ADMIN_PASSWORD=troque-esta-senha-admin

# --- Storage de fotos (MinIO / S3) ---
MINIO_ROOT_USER=versocafe
MINIO_ROOT_PASSWORD=troque-esta-senha-minio
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=versocafe-uploads
S3_ACCESS_KEY=versocafe
S3_SECRET_KEY=troque-esta-senha-minio
# Base pública das imagens. Elas são servidas pela API em /api/uploads/<chave>.
# Vazio = mesma origem (setup com Caddy). Em dev local: http://localhost:4000
S3_PUBLIC_URL=

# --- Web Push (VAPID) ---
# Gere o par de chaves com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@versocafe.local

# --- CORS (origens permitidas no acesso à API; separadas por vírgula) ---
# Em produção via Caddy é mesma origem; em dev local use http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# --- Frontend (Next.js) ---
# Base da API vista pelo navegador. Vazio = mesma origem (setup com Caddy).
NEXT_PUBLIC_API_BASE=
# Chave pública VAPID exposta ao navegador (mesma de VAPID_PUBLIC_KEY)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Rodízio ---
# Dias da semana com café (0=Dom,1=Seg,2=Ter,3=Qua,4=Qui,5=Sex,6=Sáb)
COFFEE_WEEKDAYS=1,2,3,4,5
# Instruções enviadas no aviso das 06:00 e exibidas no app
COFFEE_INSTRUCTIONS=150g de café na térmica grande
# Fuso horário usado pelo agendador (o aviso "sua vez" sai às 06:00 deste fuso)
TZ=America/Sao_Paulo

# --- Portas (host) ---
API_PORT=4000
WEB_PORT=3000
